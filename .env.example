# Public application origin, used to render shortened URLs. No domain is hard-coded in code.
VITE_APP_DOMAIN=http://localhost:3175

# TanStack Start serves /api from the same Vercel deployment.
VITE_API_ORIGIN=/api

# Neon pooled connection string. Never expose it with a VITE_ prefix.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Auth.js
AUTH_SECRET=replace-with-a-random-32-byte-secret
AUTH_TRUST_HOST=true

# Resend: both values are server-only and must not have a VITE_ prefix.
RESEND_API_KEY=re_replace_with_your_resend_api_key
RESEND_FROM_EMAIL=Linkly <powiadomienia@twoja-zweryfikowana-domena.pl>
