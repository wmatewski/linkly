# Public application origin, used to render shortened URLs. No domain is hard-coded in code.
VITE_APP_DOMAIN=http://localhost:3175

# TanStack Start serves /api from the same Vercel deployment.
VITE_API_ORIGIN=/api

# Neon pooled connection string. Never expose it with a VITE_ prefix.
